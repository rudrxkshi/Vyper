FROM python:3.13-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN groupadd --system vyper && useradd --system --gid vyper --home-dir /app vyper
WORKDIR /app
COPY requirements.lock requirements-central.lock ./
RUN pip install --no-cache-dir -r requirements.lock -r requirements-central.lock
COPY agent ./agent
COPY backend ./backend
COPY migrations ./migrations
COPY alembic.ini ./
USER vyper
EXPOSE 8000
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
