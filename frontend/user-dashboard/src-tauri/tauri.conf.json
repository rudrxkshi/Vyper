{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VYPER Local Console",
  "version": "1.0.0-rc1",
  "identifier": "com.vyper.local-console",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:local",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "VYPER Local Console",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false
  }
}
