#!/bin/sh
set -eu

PREREQ=""
prereqs() { echo "$PREREQ"; }
[ "${1:-}" = prereqs ] && { prereqs; exit 0; }

case " $(cat /proc/cmdline) " in
  *" vyper.mode=boot_sanitize "*) ;;
  *) exit 0 ;;
esac

export VYPER_EXECUTION_MODE=boot_sanitize
exec /opt/vyper/runtime/bin/python -m local_agent.boot_console
